{
  "name": "pi-finder-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pi-finder-db",
    "db:init": "wrangler d1 execute pi-finder-db --file=schema.sql",
    "db:init:remote": "wrangler d1 execute pi-finder-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.98.0"
  }
}
